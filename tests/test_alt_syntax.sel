// tests/test_alt_syntax.sel
// Comprehensive integration test suite for the modern functional alternative syntax

// 1. Math and Functions
add x y := x + y
assert(add(10, 20) == 30)

mult x y := x * y
assert(mult(6, 7) == 42)

// 2. Lambdas and Pipelines
square := \x -> x * x
assert(5 |> square == 25)

sub a b := a - b
// Thread-first: 35 |> sub(10) -> sub(35, 10) = 25
assert(35 |> sub(10) == 25)
// Thread-last: 10 |>> sub(35) -> sub(35, 10) = 25
assert(10 |>> sub(35) == 25)

// 3. Conditionals & Let bindings
val := let x = 5, y = 12 in if x < y then y - x else x - y
assert(val == 7)

// 4. Record access
point := { x: 10, y: 20 }
assert(point.x == 10)
assert(point.y == 20)

// 5. Pattern matching
grade score :=
    match score with
    | s when s >= 90 -> :a
    | s when s >= 80 -> :b
    | _ -> :c
    end

assert(grade(95) == :a)
assert(grade(85) == :b)
assert(grade(60) == :c)

// 6. List pattern matching
head_or_default list default_val :=
    match list with
    | [h | t] -> h
    | [] -> default_val
    end

assert(head_or_default([100, 200], 0) == 100)
assert(head_or_default([], 99) == 99)

// 7. Try / Catch
res := try error("fail") catch e -> :caught
assert(res == :caught)

// 8. Cross-importing a .scm module from .sel
import point as pt
p := pt.new_point(3, 4)
assert(p.x == 3)
assert(p.y == 4)

// 9. Escaped Scheme Name Identifiers (:'<name>')
assert(:'type-of'(42) == :int)
assert(:'type-of'("hello") == :string)
assert(123 |> :'to-string' == "123")

// Defining and invoking a function with a hyphenated Scheme name
:'calc-double' a b := (a + b) * 2
assert(:'calc-double'(10, 5) == 30)

// Let binding with escaped identifier
hyphen_res := let :'local-var' = 25 in :'local-var' * 4
assert(hyphen_res == 100)

// Calling hyphenated function from imported module via dot-access
p2 := pt.:'new-point'(10, 20)
assert(p2.x == 10)
assert(p2.y == 20)

// 10. Multi-clause pattern-matching functions
fib 0 := 0
fib 1 := 1
fib n := fib(n - 1) + fib(n - 2)

assert(fib(0) == 0)
assert(fib(1) == 1)
assert(fib(6) == 8)

// 11. Multi-clause with guards
fact n when n <= 1 := 1
fact n := n * fact(n - 1)

assert(fact(1) == 1)
assert(fact(5) == 120)

classify temp when temp < 0  := :freezing
classify temp when temp < 20 := :cool
classify temp when temp < 30 := :warm
classify _                   := :hot

assert(classify(-5) == :freezing)
assert(classify(15) == :cool)
assert(classify(25) == :warm)
assert(classify(35) == :hot)

// 12. Native Standard Library Prelude (.sel)
assert(is_int(42) && !is_int("42"))
assert(is_string("sel") && !is_string(123))
assert(is_even(10) && is_odd(11))
assert(type_of(100) == :int)
assert(to_string(42) == "42")

// Collection operations and pipelines from prelude
nums := [1, 2, 3, 4, 5]
assert(first(nums) == 1)
assert(rest(nums) == [2, 3, 4, 5])
assert(nums |> sum == 15)
assert(nums |> product == 120)
assert(nums |> take(3) == [1, 2, 3])
assert(nums |> drop(3) == [4, 5])
assert(nums |> contains(3))
assert(!(nums |> contains(99)))

// Higher-order pipelines with map_by and filter_by
even_doubled := nums
    |> filter_by(\x -> is_even(x))
    |> map_by(\x -> x * 10)
    |> sum

assert(even_doubled == 60) // (2*10) + (4*10) = 60

println("All alternative syntax integration tests passed!")
