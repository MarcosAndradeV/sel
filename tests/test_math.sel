// tests/test_math.sel
// Math Library & Constants Test Suite

// Constants
assert(pi > 3.14 && pi < 3.15)
assert(tau > 6.28 && tau < 6.29)
assert(e > 2.71 && e < 2.72)

// abs
assert(abs(-10) == 10)
assert(abs(10) == 10)
assert(abs(0) == 0)
assert(abs(-3.14) == 3.14)

// min & max
assert(min(5, 2, 9, 1, 7) == 1)
assert(min(42) == 42)
assert(max(5, 2, 9, 1, 7) == 9)
assert(max(-5, -20, -3) == -3)

// sqrt
assert(sqrt(0) == 0.0)
assert(sqrt(4) == 2.0)
assert(sqrt(16) == 4.0)

// pow
assert(pow(2, 3) == 8)
assert(pow(10, 0) == 1)
assert(pow(5, 2) == 25)

// floor, ceil, round
assert(floor(3.8) == 3)
assert(floor(3.1) == 3)
assert(ceil(3.1) == 4)
assert(round(3.4) == 3)
assert(round(3.6) == 4)

// Trigonometry
assert(sin(0) == 0.0)
assert(cos(0) == 1.0)
assert(abs(tan(0)) < 0.0001)

// Bitwise operations
assert(bit_and(12, 10) == 8)
assert(bit_or(12, 10) == 14)
assert(bit_xor(12, 10) == 6)
assert(bit_not(0) == -1)
assert(bit_shl(1, 4) == 16)
assert(bit_shr(16, 2) == 4)

println("All math tests passed successfully!")
