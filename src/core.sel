// src/core.sel
// SEL Standard Library Prelude
// Provides idiomatic functions, pipeline helpers, collection utilities, and standard forms.

// --- 1. Basic Assertions & Errors ---
assert test :=
    if !test then
        error("Assertion fail")
    else
        nil

// --- 2. Type Predicates & Introspection ---
is_even x := (x % 2) == 0
is_odd x := (x % 2) != 0

is_int x := type_of(x) == :int
is_float x := type_of(x) == :float
is_bool x := type_of(x) == :bool

// --- 3. List Access & Functional Helpers ---
first [x | _] := x
first [] := nil

rest [_ | xs] := xs
rest [] := []

head l := first(l)
tail l := rest(l)

last [x] := x
last [_ | xs] := last(xs)
last [] := nil

append [] l2 := l2
append [x | xs] l2 := [x | append(xs, l2)]

map f [] := []
map f [x | xs] := [f(x) | map(f, xs)]

filter f [] := []
filter f [x | xs] when f(x) := [x | filter(f, xs)]
filter f [_ | xs] := filter(f, xs)

foldl f acc [] := acc
foldl f acc [x | xs] := foldl(f, f(acc, x), xs)

foldr f acc [] := acc
foldr f acc [x | xs] := f(x, foldr(f, acc, xs))

reverse l := foldl(\acc x -> [x | acc], [], l)

// Collection-first pipeline helpers (ideal for thread-first `|>`)
map_by list f := map(f, list)
filter_by list p := filter(p, list)
reduce list acc f := foldl(f, acc, list)

// Aggregations & search
sum [] := 0
sum [x | xs] := x + sum(xs)

product [] := 1
product [x | xs] := x * product(xs)

contains [] _ := false
contains [x | _] target when x == target := true
contains [_ | xs] target := contains(xs, target)

find [] _ := nil
find [x | _] pred when pred(x) := x
find [_ | xs] pred := find(xs, pred)

any [] _ := false
any [x | _] pred when pred(x) := true
any [_ | xs] pred := any(xs, pred)

all [] _ := true
all [x | xs] pred when pred(x) := all(xs, pred)
all _ _ := false

repeat f n :=
    if n <= 0 then
        nil
    else do
        f()
        repeat(f, n - 1)
    end

range_impl limit cur step acc when cur >= limit := acc
range_impl limit cur step acc := range_impl(limit, cur + step, step, [cur | acc])

range limit := reverse(range_impl(limit, 0, 1, []))
range_from start limit := reverse(range_impl(limit, start, 1, []))
range_step start limit step := reverse(range_impl(limit, start, step, []))

// --- 4. Result / Monadic Helpers ---
ok val := [:ok, val]
err msg := [:err, msg]

is_ok [:ok | _] := true
is_ok _ := false

is_err [:err | _] := true
is_err _ := false

unwrap [:ok, val] := val
unwrap [:err, msg] := error("Called unwrap on err value: " + to_string(msg))

error_value [:err, msg] := msg
error_value [:ok, _] := error("Called error_value on ok value")

unwrap_or [:ok, val] _ := val
unwrap_or _ default_val := default_val

// --- 5. Record Utilities ---
set_field rec k v := rset(rec, k, v)
delete_field rec k := rdel(rec, k)
assoc rec k v := rset(rec, k, v)
dissoc rec k := rdel(rec, k)

// --- 6. Mathematical Constants ---
pi := 3.141592653589793
tau := 6.283185307179586
e := 2.718281828459045

// --- 7. Filesystem Conveniences ---
fs_exists path := file_system(:exists, path)
fs_read path := file_system(:read, path)
fs_write path content := file_system(:write, path, content)
fs_list path := file_system(:list, path)
fs_delete path := file_system(:delete, path)
