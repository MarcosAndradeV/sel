// examples/type_system_demo.sel
// Comprehensive demonstration of the SEL Static Type System (Option 1A & ADR 0001/0002)

// 1. Higher-order parametric polymorphism with `forany`
filter :: forany(A) : (A -> bool), [A] -> [A]
filter f [] := []
filter f [x | xs] when f(x) := [x | filter(f, xs)]
filter f [_ | xs] := filter(f, xs)

evens := filter(\x -> (x % 2) == 0, [1, 2, 3, 4, 5, 6])
println("Filtered evens:", evens)

// 2. Trait constraints with `where implements(A, :trait)`
unique :: forany(A) where implements(A, :comparable) : [A] -> [A]
unique [] := []
unique [x | xs] := [x | unique(filter(\y -> y != x, xs))]

nums := unique([1, 2, 2, 3, 1, 4, 3])
println("Unique numbers:", nums)

// 3. Nominal Types with `newtype`, transparent dot-access, and constructor
newtype Foo := { c: int }

// Derive standard `:comparable` trait
derive(Foo, :comparable)

// Custom trait implementation for :showable
implements(Foo, :showable, \self -> format("Foo({ c: {} })", self.c))

f1 := Foo({ c: 10 })
f2 := Foo({ c: 10 })
f3 := Foo({ c: 20 })

println("Printing showable f1:", f1)
println("Nominal transparent access f1.c:", f1.c)
println("Nominal type tag:", type_of(f1))
println("Nominal equality f1 == f2:", f1 == f2)
println("Nominal equality f1 == f3:", f1 == f3)

// Passing Foo instances into trait-bounded generic function `unique`
unique_foos := unique([f1, f2, f3])
println("Unique Foo count:", count(unique_foos))

// 4. User-Defined Traits with multi-method dispatch & pipelines
pub trait :geometry := {
    area: Self -> float,
    perimeter: Self -> float
}

newtype Circle := { radius: float }
newtype Rectangle := { width: float, height: float }

implements(Circle, :geometry, {
    area: \c -> 3.14159 * c.radius * c.radius,
    perimeter: \c -> 2.0 * 3.14159 * c.radius
})

implements(Rectangle, :geometry, {
    area: \r -> r.width * r.height,
    perimeter: \r -> 2.0 * (r.width + r.height)
})

c := Circle({ radius: 5.0 })
r := Rectangle({ width: 4.0, height: 6.0 })

println("Circle area:", area(c))
println("Rectangle area:", area(r))
println("Circle perimeter via pipeline:", c |> perimeter)
println("Rectangle perimeter via pipeline:", r |> perimeter)

// Generic function bounded by user-defined trait
describe_shape :: forany(A) where implements(A, :geometry) : A -> string
describe_shape shape := format("Shape area={}, perimeter={}", area(shape), perimeter(shape))

println(describe_shape(c))
println(describe_shape(r))
