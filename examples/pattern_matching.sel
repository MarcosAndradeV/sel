// examples/pattern_matching.sel
// Demonstrates advanced pattern matching features in SEL:
// - Structural destructuring (lists, records, cons)
// - As-patterns (var @ pattern)
// - Parenthesized Or-patterns ((pat1 | pat2 | ...))
// - Destructuring let bindings
// - Multi-clause pattern functions with guards

println("=== SEL Advanced Pattern Matching Showcase ===")
newline()

// 1. As-patterns: capturing the whole container alongside its components
inspect_batch all @ [] := "Batch is empty"
inspect_batch all @ [single] := format("Single item batch: {}", single)
inspect_batch all @ [head | tail] :=
    format("Batch of {} items starting with '{}' and {} remaining", count(all), head, count(tail))

println(inspect_batch([]))
println(inspect_batch(["alpha"]))
println(inspect_batch(["task_1", "task_2", "task_3", "task_4"]))
newline()

// 2. Parenthesized Or-patterns: matching multiple alternatives
http_status_category (200 | 201 | 204) := :success
http_status_category (301 | 302 | 304) := :redirection
http_status_category (400 | 401 | 403 | 404) := :client_error
http_status_category (500 | 502 | 503) := :server_error
http_status_category _ := :unknown

responses := [200, 404, 500, 301, 418]
categories := responses |> map_by(\code -> [code, http_status_category(code)])
println("HTTP Status classifications:")
println(categories)
newline()

// 3. Destructuring let: unpacking records and tuples
user_record := { id: 42, username: "dev_marcos", role: :admin, score: 980 }

formatted_user :=
    let { username, role, score } = user_record,
        status = if score > 500 then "Veteran" else "Novice"
    in format("User '{}' [{}] - Status: {}", username, role, status)

println("Destructured User Record:")
println(formatted_user)
newline()

// 4. Combined As-pattern with Record and Nested Or-pattern
authorize u @ { role: (:admin | :owner), username } :=
    format("Access granted to privileged user '{}' (id: {})", username, u.id)
authorize { username, role } :=
    format("Access denied for user '{}' with role '{}'", username, role)
authorize _ :=
    "Invalid user payload"

println(authorize(user_record))
println(authorize({ id: 99, username: "guest_bob", role: :viewer, score: 10 }))
newline()

// 5. Destructuring combined with pipelines
points := [[10, 20], [30, 40], [5, 12]]
magnitudes := points |> map_by(\p ->
    let [x, y] = p
    in sqrt(x * x + y * y)
)
println("Point magnitudes:", magnitudes)
